NODE_ENV=development
PORT=3001

# OpenRouter — get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_TEXT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_VISION_MODEL=google/gemma-3-27b-it:free

# Auth secret (any random string for local dev)
JWT_SECRET=change-me

# Google AI Studio fallback — get a free key at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
GOOGLE_AI_TEXT_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-2.0-flash
GOOGLE_AI_VISION_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-2.0-flash
